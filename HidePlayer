-- Speed Hack di tab Player (dengan adjustable speed via TextBox)
do
    local speedHackBtn = Instance.new("TextButton")
    speedHackBtn.Size = UDim2.new(0,170,0,38)
    speedHackBtn.Position = UDim2.new(0.06,0,0.08,0)
    speedHackBtn.BackgroundColor3 = Color3.fromRGB(85,0,0)  -- Ubah ke merah menyala gelap
    speedHackBtn.Text = "Speed Hack (OFF)"
    speedHackBtn.TextColor3 = Color3.new(1,1,1)
    speedHackBtn.Font = Enum.Font.Gotham
    speedHackBtn.TextSize = 16
    speedHackBtn.Parent = tabPlayer

    local c = Instance.new("UICorner", speedHackBtn); c.CornerRadius = UDim.new(0,8)

    local speedEnabled = false
    local originalSpeed = 16           -- Default Roblox WalkSpeed
    local hackSpeed = 50               -- Default nilai awal (bisa diubah)

    -- Fungsi untuk apply speed
    local function applySpeed()
        if lp.Character and lp.Character:FindFirstChild("Humanoid") then
            lp.Character.Humanoid.WalkSpeed = speedEnabled and hackSpeed or originalSpeed
        end
    end

    local function enableSpeedHack()
        speedEnabled = true
        speedHackBtn.Text = "Speed Hack (ON)"
        speedHackBtn.BackgroundColor3 = Color3.fromRGB(60,140,80)
        applySpeed()
    end

    local function disableSpeedHack()
        speedEnabled = false
        speedHackBtn.Text = "Speed Hack (OFF)"
        speedHackBtn.BackgroundColor3 = Color3.fromRGB(85,0,0)  -- Ubah ke merah menyala gelap
        applySpeed()
    end

    speedHackBtn.MouseButton1Click:Connect(function()
        if speedEnabled then
            disableSpeedHack()
        else
            enableSpeedHack()
        end
    end)

    -- Label & TextBox untuk atur speed (bisa diketik & Enter)
    local speedLabel = Instance.new("TextLabel")
    speedLabel.Size = UDim2.new(0,120,0,30)
    speedLabel.Position = UDim2.new(0.06,0,0.22,0)
    speedLabel.BackgroundTransparency = 1
    speedLabel.Text = "Speed Value:"
    speedLabel.TextColor3 = Color3.fromRGB(255,200,200)
    speedLabel.Font = Enum.Font.Gotham
    speedLabel.TextSize = 15
    speedLabel.TextXAlignment = Enum.TextXAlignment.Left
    speedLabel.Parent = tabPlayer

    local speedBox = Instance.new("TextBox")
    speedBox.Size = UDim2.new(0,100,0,30)
    speedBox.Position = UDim2.new(0.06,130,0.22,0)
    speedBox.BackgroundColor3 = Color3.fromRGB(60,0,0)  -- Ubah ke merah menyala gelap
    speedBox.BorderSizePixel = 0
    speedBox.Text = tostring(hackSpeed)
    speedBox.TextColor3 = Color3.new(1,1,1)
    speedBox.Font = Enum.Font.Gotham
    speedBox.TextSize = 15
    speedBox.ClearTextOnFocus = false
    speedBox.Parent = tabPlayer

    local cornerSpeed = Instance.new("UICorner", speedBox)
    cornerSpeed.CornerRadius = UDim.new(0,6)

    -- Saat tekan Enter di TextBox → update speed & apply langsung jika aktif
    speedBox.FocusLost:Connect(function(enterPressed)
        if enterPressed then
            local newSpeed = tonumber(speedBox.Text)
            if newSpeed and newSpeed >= 0 then
                hackSpeed = newSpeed
                print("Speed hack diubah menjadi: " .. hackSpeed)

                -- Apply langsung jika speed hack sedang aktif
                if speedEnabled then
                    applySpeed()
                end
            else
                -- Kembalikan ke nilai sebelumnya jika input salah
                speedBox.Text = tostring(hackSpeed)
            end
        end
    end)

    -- Handle character respawn / reset
    lp.CharacterAdded:Connect(function(char)
        char:WaitForChild("Humanoid")
        originalSpeed = char.Humanoid.WalkSpeed  -- simpan nilai asli
        if speedEnabled then
            char.Humanoid.WalkSpeed = hackSpeed
        end
    end)

    -- Jika humanoid mati/respawn, pastikan speed tetap apply
    if lp.Character and lp.Character:FindFirstChild("Humanoid") then
        originalSpeed = lp.Character.Humanoid.WalkSpeed
        if speedEnabled then
            lp.Character.Humanoid.WalkSpeed = hackSpeed
        end
    end
end

