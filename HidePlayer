local function CreateEpicIntro()
    print("🚀 IndoHub Compact - INSANE INTRO 2026 🔥")

    local IntroGui = Instance.new("ScreenGui")
    IntroGui.Name = "IndoHubEpicIntro"
    IntroGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    IntroGui.DisplayOrder = 10000
    IntroGui.IgnoreGuiInset = true
    IntroGui.Parent = gethui and gethui() or game.CoreGui

    local IntroFrame = Instance.new("Frame")
    IntroFrame.Size = UDim2.new(1,0,1,0)
    IntroFrame.BackgroundColor3 = Color3.fromRGB(10,6,6)
    IntroFrame.BackgroundTransparency = 0.3
    IntroFrame.Parent = IntroGui

    -- Vignette
    local Vignette = Instance.new("ImageLabel")
    Vignette.Size = UDim2.new(1,0,1,0)
    Vignette.BackgroundTransparency = 1
    Vignette.Image = "rbxassetid://6014261993"
    Vignette.ImageTransparency = 0.4
    Vignette.Parent = IntroFrame

    -- Matrix rain (sedikit lebih ringan)
    local MatrixContainer = Instance.new("Frame")
    MatrixContainer.Size = UDim2.new(1,0,1,0)
    MatrixContainer.BackgroundTransparency = 1
    MatrixContainer.Parent = IntroFrame

    local matrixChars = {}
    for i = 1, 100 do
        local char = Instance.new("TextLabel")
        char.Size = UDim2.new(0,14,0,20)
        char.Position = UDim2.new(math.random(),0,-0.3,math.random(-400,0))
        char.BackgroundTransparency = 1
        char.Text = string.char(math.random(33,126))
        char.TextColor3 = Color3.fromRGB(math.random(140,255), 0, math.random(80,220))
        char.Font = Enum.Font.Code
        char.TextSize = math.random(10,20)
        char.TextTransparency = 0.3
        char.Parent = MatrixContainer
        table.insert(matrixChars, {obj = char, speed = math.random(4,14)})
    end

    RS:BindToRenderStep("MatrixRain", 200, function(dt)
        for _, v in ipairs(matrixChars) do
            local pos = v.obj.Position
            local newY = pos.Y.Scale + (dt * v.speed * 0.7)
            v.obj.Position = UDim2.new(pos.X.Scale, pos.X.Offset, newY, pos.Y.Offset)
            if newY > 1.3 then
                v.obj.Position = UDim2.new(math.random(),0,-0.25,math.random(-300,0))
            end
        end
    end)

    -- Rotating cube (ukuran sedikit dikecilkan)
    local CubeFrame = Instance.new("Frame")
    CubeFrame.Size = UDim2.new(0,260,0,260)
    CubeFrame.Position = UDim2.new(0.5,-130,0.5,-130)
    CubeFrame.BackgroundTransparency = 1
    CubeFrame.Parent = IntroFrame

    for i = 1, 12 do
        local edge = Instance.new("Frame")
        edge.BackgroundColor3 = Color3.fromRGB(255,0,0)  -- Ubah ke merah menyala
        edge.BorderSizePixel = 0
        edge.Size = UDim2.new(0,2.5,0, math.random(160,240))
        edge.Position = UDim2.new(0.5,0,0.5,0)
        edge.AnchorPoint = Vector2.new(0.5,0.5)
        edge.Rotation = i * 30
        edge.Parent = CubeFrame

        TS:Create(edge, TweenInfo.new(6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {
            Rotation = (i * 30) + 360,
            BackgroundTransparency = 0.4
        }):Play()
    end

    -- Logo glitch (ukuran teks sedikit dikurangi)
    local LogoText = Instance.new("TextLabel")
    LogoText.Size = UDim2.new(0,0,0,90)
    LogoText.Position = UDim2.new(0.5,0,0.42,0)
    LogoText.AnchorPoint = Vector2.new(0.5,0.5)
    LogoText.BackgroundTransparency = 1
    LogoText.Text = ""
    LogoText.TextColor3 = Color3.fromRGB(255,255,255)
    LogoText.Font = Enum.Font.GothamBlack
    LogoText.TextSize = 80
    LogoText.TextStrokeTransparency = 0.65
    LogoText.TextStrokeColor3 = Color3.fromRGB(255,0,0)  -- Ubah ke merah menyala
    LogoText.Parent = IntroFrame

    local glitchStroke = Instance.new("UIStroke")
    glitchStroke.Color = Color3.fromRGB(255,0,0)  -- Ubah ke merah menyala
    glitchStroke.Thickness = 3.5
    glitchStroke.Transparency = 0.45
    glitchStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    glitchStroke.Parent = LogoText

    local fullText = "IndoHub X Executor"
    local currentText = ""

    spawn(function()
        for i = 1, #fullText do
            currentText = currentText .. fullText:sub(i,i)
            LogoText.Text = currentText
            LogoText.Size = UDim2.new(0, #currentText * 52, 0, 90)

            for _ = 1, math.random(2,4) do
                LogoText.TextTransparency = math.random(0.25,0.75)
                glitchStroke.Color = Color3.fromRGB(math.random(200,255), math.random(0,50), math.random(0,50))  -- Variasi merah menyala
                task.wait(0.03)
            end
            LogoText.TextTransparency = 0
            glitchStroke.Color = Color3.fromRGB(255,0,0)  -- Ubah ke merah menyala
            task.wait(0.08)
        end

        spawn(function()
            while LogoText.Parent do
                TS:Create(LogoText, TweenInfo.new(1.3, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {
                    TextStrokeTransparency = 0.3
                }):Play()
                TS:Create(glitchStroke, TweenInfo.new(1.3, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {
                    Thickness = 6,
                    Transparency = 0.2
                }):Play()
                task.wait(2.6)
            end
        end)
    end)

    -- Subtitle lebih kecil
    local SubText = Instance.new("TextLabel")
    SubText.Size = UDim2.new(0,420,0,50)
    SubText.Position = UDim2.new(0.5,0,0.58,0)
    SubText.AnchorPoint = Vector2.new(0.5,0.5)
    SubText.BackgroundTransparency = 1
    SubText.Text = "IndoHub X Executor • By Death"
    SubText.TextColor3 = Color3.fromRGB(255,100,100)  -- Ubah ke merah menyala lebih gelap
    SubText.Font = Enum.Font.Gotham
    SubText.TextSize = 28
    SubText.TextTransparency = 1
    SubText.Parent = IntroFrame

    -- Shockwave + particle (sedikit dikurangi jumlah)
    local Shockwave = Instance.new("Frame")
    Shockwave.Size = UDim2.new(0,0,0,0)
    Shockwave.Position = UDim2.new(0.5,0,0.5,0)
    Shockwave.AnchorPoint = Vector2.new(0.5,0.5)
    Shockwave.BackgroundTransparency = 1
    Shockwave.Parent = IntroFrame

    local shockCorner = Instance.new("UICorner")
    shockCorner.CornerRadius = UDim.new(1,0)
    shockCorner.Parent = Shockwave

    local shockStroke = Instance.new("UIStroke")
    shockStroke.Color = Color3.fromRGB(255,0,0)  -- Ubah ke merah menyala
    shockStroke.Thickness = 4.5
    shockStroke.Transparency = 0.3
    shockStroke.Parent = Shockwave

    spawn(function()
        task.wait(1.5)
        for i = 1, 35 do
            local p = Instance.new("Frame")
            p.Size = UDim2.new(0, math.random(4,12), 0, math.random(4,12))
            p.Position = UDim2.new(0.5,0,0.5,0)
            p.BackgroundColor3 = Color3.fromHSV(math.random(), 0.85, 1)
            p.BackgroundTransparency = 0
            p.AnchorPoint = Vector2.new(0.5,0.5)
            p.Parent = IntroFrame

            local angle = math.rad(math.random(0,360))
            local dist = math.random(140,380)

            TS:Create(p, TweenInfo.new(1.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
                Position = UDim2.new(0.5, math.cos(angle)*dist, 0.5, math.sin(angle)*dist),
                BackgroundTransparency = 1,
                Rotation = math.random(-600,600)
            }):Play()

            Debris:AddItem(p, 1.4)
        end

        TS:Create(Shockwave, TweenInfo.new(1.7, Enum.EasingStyle.Quint), {
            Size = UDim2.new(0,1200,0,1200),
            UIStroke = {Transparency = 1}
        }):Play()
    end)

    -- Screen shake
    spawn(function()
        task.wait(1.7)
        for i = 1, 12 do
            local offset = UDim2.new(math.random(-0.01,0.01), math.random(-12,12), math.random(-0.01,0.01), math.random(-12,12))
            TS:Create(IntroFrame, TweenInfo.new(0.08, Enum.EasingStyle.Bounce), {Position = offset}):Play()
            task.wait(0.085)
        end
