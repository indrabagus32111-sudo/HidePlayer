--            ANTI LAG - DI SAMPING ESP (Tab Visual)
-- =============================================

do
    local antiLagBtn = Instance.new("TextButton")
    antiLagBtn.Size = UDim2.new(0, 170, 0, 38)
    antiLagBtn.Position = UDim2.new(0.52, 0, 0.08, 0)   -- di samping ESP (sejajar seperti Jump di samping Speed)
    antiLagBtn.BackgroundColor3 = Color3.fromRGB(85,0,0)  -- Ubah ke merah menyala gelap
    antiLagBtn.Text = "Anti Lag (OFF)"
    antiLagBtn.TextColor3 = Color3.new(1,1,1)
    antiLagBtn.Font = Enum.Font.Gotham
    antiLagBtn.TextSize = 16
    antiLagBtn.Parent = tabVisual

    local cornerAntiLag = Instance.new("UICorner", antiLagBtn)
    cornerAntiLag.CornerRadius = UDim.new(0,8)

    local antiLagEnabled = false
    local antiLagConnection

    -- Fungsi optimasi anti-lag (contoh sederhana & aman)
    local function optimizeGame()
        -- Kurangi fallen parts destroy height (hilangkan parts jatuh terlalu jauh)
        workspace.FallenPartsDestroyHeight = -500  -- default -500, bisa lebih rendah jika perlu

        -- Bersihkan Debris
        Debris:ClearAllChildren()

        -- Kurangi kualitas grafis (jika memungkinkan di executor)
        pcall(function()
            settings().Rendering.QualityLevel = Enum.QualityLevel.Level01  -- rendah
            workspace.LevelOfDetail = Enum.ModelLevelOfDetail.Disabled
        end)

        -- Matikan unnecessary effects (misal lighting)
        pcall(function()
            game.Lighting.GlobalShadows = false
            game.Lighting.Brightness = 1
            game.Lighting.FogEnd = 99999  -- hilangkan fog jika ada
        end)

        -- Hilangkan unnecessary parts (opsional - scan & remove small debris)
        for _, obj in ipairs(workspace:GetChildren()) do
            if obj:IsA("Part") and obj.Name == "Debris" or obj.Size.Magnitude < 1 then
                pcall(function() obj:Destroy() end)
            end
        end
    end

    local function toggleAntiLag()
        antiLagEnabled = not antiLagEnabled
        
        if antiLagEnabled then
            antiLagBtn.Text = "Anti Lag (ON)"
            antiLagBtn.BackgroundColor3 = Color3.fromRGB(60,140,80)
            
            -- Jalankan optimasi awal
            optimizeGame()
            
            -- Loop setiap 10 detik untuk maintain
            if antiLagConnection then antiLagConnection:Disconnect() end
            antiLagConnection = RS.Heartbeat:Connect(function()
                if not antiLagEnabled then return end
                optimizeGame()  -- jalankan ulang (bisa dikurangi frekuensi jika terlalu heavy)
                task.wait(10)   -- tunggu 10 detik per loop
            end)
        else
            antiLagBtn.Text = "Anti Lag (OFF)"
            antiLagBtn.BackgroundColor3 = Color3.fromRGB(85,0,0)  -- Ubah ke merah menyala gelap
            if antiLagConnection then
                antiLagConnection:Disconnect()
                antiLagConnection = nil
            end
            
            -- Kembalikan setting default (opsional)
            pcall(function()
                settings().Rendering.QualityLevel = Enum.QualityLevel.Automatic
                workspace.LevelOfDetail = Enum.ModelLevelOfDetail.Automatic
                game.Lighting.GlobalShadows = true
                game.Lighting.Brightness = 2  -- default Roblox
            end)
        end
    end

    antiLagBtn.MouseButton1Click:Connect(toggleAntiLag)

    -- Handle respawn (re-apply jika ON)
    lp.CharacterAdded:Connect(function()
        task.wait(0.5)
        if antiLagEnabled then
            optimizeGame()
        end
    end)

    -- Apply awal jika sudah ada karakter
    if lp.Character and antiLagEnabled then
        optimizeGame()
    end

    print("Anti Lag button added beside ESP in Visual tab")
end

