    task.wait(2.6)
    TS:Create(SubText, TweenInfo.new(1.3, Enum.EasingStyle.Quint), {TextTransparency = 0}):Play()

    task.wait(3.8)
    TS:Create(IntroFrame, TweenInfo.new(2, Enum.EasingStyle.Quint), {BackgroundTransparency = 1}):Play()
    TS:Create(LogoText, TweenInfo.new(1.5), {TextTransparency = 1}):Play()
    TS:Create(SubText, TweenInfo.new(1.5), {TextTransparency = 1}):Play()
    task.wait(2.1)
    IntroGui:Destroy()
    RS:UnbindFromRenderStep("MatrixRain")

    print("✅ Intro selesai – DarkBird Compact Hub ready")
