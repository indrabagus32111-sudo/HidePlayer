    cornerNoclip.CornerRadius = UDim.new(0,8)

    local noclipConnection
    local noclipEnabled = false

    local function toggleNoclip()
        noclipEnabled = not noclipEnabled
        
        if noclipEnabled then
            noclipBtn.Text = "Noclip (ON)"
            noclipBtn.BackgroundColor3 = Color3.fromRGB(60,140,80)
            
            -- Matikan collision
            if noclipConnection then noclipConnection:Disconnect() end
            
            noclipConnection = RS.Stepped:Connect(function()
                if not noclipEnabled then return end
                if not lp.Character then return end
                
                for _, part in ipairs(lp.Character:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end
            end)
        else
            noclipBtn.Text = "Noclip (OFF)"
            noclipBtn.BackgroundColor3 = Color3.fromRGB(85,0,0)  -- Ubah ke merah menyala gelap
            if noclipConnection then
                noclipConnection:Disconnect()
                noclipConnection = nil
            end
            
            -- Kembalikan collision (opsional - ke default)
            if lp.Character then
                for _, part in ipairs(lp.Character:GetDescendants()) do
                    if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                        part.CanCollide = true
                    end
                end
            end
        end
    end

    noclipBtn.MouseButton1Click:Connect(toggleNoclip)

    -- Cleanup saat karakter respawn
    lp.CharacterAdded:Connect(function(newChar)
        task.wait(0.4) -- tunggu humanoid & parts load
        
        -- Reset status visual button jika noclip mati
        if not noclipEnabled then
            noclipBtn.Text = "Noclip (OFF)"
            noclipBtn.BackgroundColor3 = Color3.fromRGB(85,0,0)  -- Ubah ke merah menyala gelap
        end
        
        -- Jika masih ON → langsung terapkan lagi
        if noclipEnabled and noclipConnection == nil then
            toggleNoclip()   -- toggle ulang untuk reconnect
            toggleNoclip()   -- kembali ke ON
        end
    end)

    -- Optional: matikan noclip saat karakter hilang
    if lp.Character then
        -- sudah ditangani di Stepped check
    end

    print("Noclip added below Speed Hack in Player tab")
end

