    local function ChangeTheme(primary)
        CurrentThemeColor = primary
        SHARED_THEME_COLOR = primary
        
        local h, s, v = primary:ToHSV()
        local dark1 = Color3.fromHSV(h, s, math.clamp(v * 0.4, 0, 1))
        local dark2 = Color3.fromHSV(h, s, math.clamp(v * 0.15, 0, 1))
        local mid = Color3.fromHSV(h, s, math.clamp(v * 0.6, 0, 1))
        
        SHARED_DARK_COLOR = dark1
        SHARED_DARK2_COLOR = dark2

        for _, stroke in ipairs(ThemeCore.Strokes) do stroke.Color = primary end
        for _, txt in ipairs(ThemeCore.Texts) do txt.TextColor3 = primary end
        for _, line in ipairs(ThemeCore.Lines) do if line.Parent then line.BackgroundColor3 = primary end end
        for _, bg in ipairs(ThemeCore.DarkBGs) do if bg.Parent then bg.BackgroundColor3 = dark2 end end
        for _, dtog in ipairs(ThemeCore.DarkToggles) do
            if dtog.Btn.Parent then dtog.Btn.BackgroundColor3 = dtog.GetState() and primary or dark2 end
        end

        if ThemeCore.MainGrad then
            ThemeCore.MainGrad.Color = ColorSequence.new{
                ColorSequenceKeypoint.new(0, dark1),
                ColorSequenceKeypoint.new(1, dark2)
            }
        end
        if ThemeCore.SideGrad then
            ThemeCore.SideGrad.Color = ColorSequence.new{
                ColorSequenceKeypoint.new(0, dark1),
                ColorSequenceKeypoint.new(1, dark2)
            }
        end
        if ThemeCore.ToggleGrad then
            ThemeCore.ToggleGrad.Color = ColorSequence.new{
                ColorSequenceKeypoint.new(0, mid),
                ColorSequenceKeypoint.new(1, primary)
            }
        end
        if ThemeCore.ToggleBtn then ThemeCore.ToggleBtn.TextColor3 = primary end
        
        for _, toggle in ipairs(ThemeCore.Toggles) do
            if toggle.Btn.Parent then
                toggle.Btn.BackgroundColor3 = toggle.GetState() and SHARED_THEME_COLOR or SHARED_DARK_COLOR
