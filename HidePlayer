do
    local flyBtn = Instance.new("TextButton")
    flyBtn.Size = UDim2.new(0, 220, 0, 45)
    flyBtn.Position = UDim2.new(0.5, -110, 0.32, 0)  -- Bawah IY (~0.15 + 0.17 margin, adjust kalau overlap)
    flyBtn.BackgroundColor3 = Color3.fromRGB(85,0,0)
    flyBtn.Text = "Fly (OFF)"
    flyBtn.TextColor3 = Color3.new(1,1,1)
    flyBtn.Font = Enum.Font.GothamSemibold
    flyBtn.TextSize = 18
    flyBtn.Parent = tabMain

    local cornerFly = Instance.new("UICorner", flyBtn)
    cornerFly.CornerRadius = UDim.new(0,9)

    local strokeFly = Instance.new("UIStroke", flyBtn)
    strokeFly.Color = Color3.fromRGB(255,0,0)
    strokeFly.Thickness = 1.5
    strokeFly.Transparency = 0.6

    local flyEnabled = false
    local flySpeed = 50  -- Default speed
    local bodyVel, bodyGyro

    local function startFly()
        local char = lp.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then return end
        local root = char.HumanoidRootPart

        bodyVel = Instance.new("BodyVelocity")
        bodyVel.MaxForce = Vector3.new(1e9, 1e9, 1e9)
        bodyVel.Velocity = Vector3.new(0,0,0)
        bodyVel.Parent = root

        bodyGyro = Instance.new("BodyGyro")
        bodyGyro.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
        bodyGyro.CFrame = root.CFrame
        bodyGyro.P = 20000
        bodyGyro.Parent = root

        local cam = workspace.CurrentCamera
        local moving = {forward = 0, right = 0, up = 0}

        local conn
        conn = RS.RenderStepped:Connect(function()
            if not flyEnabled or not root.Parent then
                conn:Disconnect()
                if bodyVel then bodyVel:Destroy() end
                if bodyGyro then bodyGyro:Destroy() end
                return
            end

            local moveDir = Vector3.new(moving.right, moving.up, moving.forward)
            if moveDir.Magnitude > 0 then
                moveDir = moveDir.Unit
            end

            local worldMove = (cam.CFrame.LookVector * moveDir.Z + cam.CFrame.RightVector * moveDir.X + Vector3.new(0, moveDir.Y, 0)) * flySpeed
            bodyVel.Velocity = worldMove
            bodyGyro.CFrame = cam.CFrame
        end)
    end

    local function stopFly()
        if bodyVel then bodyVel:Destroy() bodyVel = nil end
        if bodyGyro then bodyGyro:Destroy() bodyGyro = nil end
    end

    local function toggleFly()
        flyEnabled = not flyEnabled
        
        if flyEnabled then
            flyBtn.Text = "Fly (ON)"
            flyBtn.BackgroundColor3 = Color3.fromRGB(60,140,80)
            strokeFly.Color = Color3.fromRGB(100,255,150)
            startFly()
        else
            flyBtn.Text = "Fly (OFF)"
            flyBtn.BackgroundColor3 = Color3.fromRGB(85,0,0)
            strokeFly.Color = Color3.fromRGB(255,0,0)
            stopFly()
        end
    end

    flyBtn.MouseButton1Click:Connect(toggleFly)

    -- Kontrol gerakan (WASD + Space/Ctrl)
    local inputConn = UIS.InputBegan:Connect(function(input, gp)
        if gp then return end
        if not flyEnabled then return end

        if input.KeyCode == Enum.KeyCode.W then moving.forward = 1
        elseif input.KeyCode == Enum.KeyCode.S then moving.forward = -1
        elseif input.KeyCode == Enum.KeyCode.A then moving.right = -1
        elseif input.KeyCode == Enum.KeyCode.D then moving.right = 1
        elseif input.KeyCode == Enum.KeyCode.Space then moving.up = 1
        elseif input.KeyCode == Enum.KeyCode.LeftControl then moving.up = -1 end
    end)

    local inputEnded = UIS.InputEnded:Connect(function(input)
        if input.KeyCode == Enum.KeyCode.W or input.KeyCode == Enum.KeyCode.S then moving.forward = 0
        elseif input.KeyCode == Enum.KeyCode.A or input.KeyCode == Enum.KeyCode.D then moving.right = 0
        elseif input.KeyCode == Enum.KeyCode.Space or input.KeyCode == Enum.KeyCode.LeftControl then moving.up = 0 end
    end)

    -- TextBox adjust speed
    local speedLabelFly = Instance.new("TextLabel")
    speedLabelFly.Size = UDim2.new(0,120,0,30)
    speedLabelFly.Position = UDim2.new(0.5, -110, 0.42, 0)  -- Bawah tombol fly
    speedLabelFly.BackgroundTransparency = 1
    speedLabelFly.Text = "Fly Speed:"
    speedLabelFly.TextColor3 = Color3.fromRGB(255,200,200)
    speedLabelFly.Font = Enum.Font.Gotham
    speedLabelFly.TextSize = 15
    speedLabelFly.Parent = tabMain

    local speedBoxFly = Instance.new("TextBox")
    speedBoxFly.Size = UDim2.new(0,100,0,30)
    speedBoxFly.Position = UDim2.new(0.5, 20, 0.42, 0)
    speedBoxFly.BackgroundColor3 = Color3.fromRGB(60,0,0)
    speedBoxFly.Text = tostring(flySpeed)
    speedBoxFly.TextColor3 = Color3.new(1,1,1)
    speedBoxFly.Font = Enum.Font.Gotham
    speedBoxFly.TextSize = 15
    speedBoxFly.ClearTextOnFocus = false
    speedBoxFly.Parent = tabMain

    local cornerSpeedFly = Instance.new("UICorner", speedBoxFly)
    cornerSpeedFly.CornerRadius = UDim.new(0,6)

    speedBoxFly.FocusLost:Connect(function(enter)
        if enter then
            local val = tonumber(speedBoxFly.Text)
            if val and val > 0 then
                flySpeed = val
                print("Fly speed diubah ke: " .. flySpeed)
            else
                speedBoxFly.Text = tostring(flySpeed)
            end
        end
    end)

    -- Respawn handler
    lp.CharacterAdded:Connect(function()
        task.wait(0.5)
        stopFly()  -- Stop dulu biar ga bug
        if flyEnabled then
            startFly()  -- Restart fly
        end
    end)

    -- Cleanup pas unload (opsional)
    game:BindToClose(function()
        stopFly()
    end)

    print("Fly Toggle + Adjustable Speed added below Infinite Yield – terbang mulu bro!")
end

