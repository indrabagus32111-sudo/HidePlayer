--                  ESP PLAYER (Visual Tab) - FIXED
-- =============================================

do
    local ESP_ENABLED = false
    local ESP_OBJECTS = {}   -- [player] = {box, name, dist, hpBg, hp, connection}

    local ESP_BUTTON = Instance.new("TextButton")
    ESP_BUTTON.Size = UDim2.new(0, 170, 0, 38)
    ESP_BUTTON.Position = UDim2.new(0.06, 0, 0.08, 0)
    ESP_BUTTON.BackgroundColor3 = Color3.fromRGB(85,0,0)  -- Ubah ke merah menyala gelap
    ESP_BUTTON.Text = "Player ESP (OFF)"
    ESP_BUTTON.TextColor3 = Color3.new(1,1,1)
    ESP_BUTTON.Font = Enum.Font.Gotham
    ESP_BUTTON.TextSize = 16
    ESP_BUTTON.Parent = tabVisual

    local cornerEsp = Instance.new("UICorner", ESP_BUTTON)
    cornerEsp.CornerRadius = UDim.new(0,8)

    -- Warna
    local COLOR_ENEMY = Color3.fromRGB(255, 0, 0)  -- Ubah ke merah menyala
    local COLOR_ALLY  = Color3.fromRGB(255, 160, 80)
    local COLOR_TEXT  = Color3.fromRGB(255, 255, 255)

    local function getPlayerColor(player)
        if player.Team and lp.Team and player.Team == lp.Team then
            return COLOR_ALLY
        end
        return COLOR_ENEMY
    end

    local function createOrUpdateESP(player)
        if player == lp then return end

        local entry = ESP_OBJECTS[player]
        if not entry then
            -- Buat baru jika belum ada
            local box = Drawing.new("Square")
            box.Thickness = 2
            box.Filled = false
            box.Transparency = 1
            box.Visible = false

            local nameTag = Drawing.new("Text")
            nameTag.Size = 14
            nameTag.Center = true
            nameTag.Outline = true
            nameTag.Font = Drawing.Fonts.UI  -- lebih aman di beberapa executor
            nameTag.Visible = false

            local distTag = Drawing.new("Text")
            distTag.Size = 12
            distTag.Center = true
            distTag.Outline = true
            distTag.Font = Drawing.Fonts.UI
            distTag.Visible = false

            local hpBg = Drawing.new("Line")
            hpBg.Thickness = 3
            hpBg.Color = Color3.fromRGB(40,40,40)
            hpBg.Transparency = 0.7
            hpBg.Visible = false

            local hpBar = Drawing.new("Line")
            hpBar.Thickness = 3
            hpBar.Transparency = 1
            hpBar.Visible = false

            entry = {
                box = box,
                name = nameTag,
                dist = distTag,
                hpBg = hpBg,
                hp = hpBar,
                connection = nil
            }
            ESP_OBJECTS[player] = entry
        end

        -- Cleanup koneksi lama jika ada
        if entry.connection then
            entry.connection:Disconnect()
            entry.connection = nil
        end

        -- Buat koneksi baru
        entry.connection = RS.RenderStepped:Connect(function()
            if not ESP_ENABLED then return end

            local char = player.Character
            if not char or not char.Parent then
                -- Sembunyikan jika karakter hilang
                for _, obj in pairs({entry.box, entry.name, entry.dist, entry.hpBg, entry.hp}) do
                    obj.Visible = false
                end
                return
            end

            local humanoid = char:FindFirstChildWhichIsA("Humanoid")
            local root = char:FindFirstChild("HumanoidRootPart")
            local head = char:FindFirstChild("Head")

            if not (humanoid and root and head and humanoid.Health > 0) then
                for _, obj in pairs({entry.box, entry.name, entry.dist, entry.hpBg, entry.hp}) do
                    obj.Visible = false
                end
                return
            end

            local cam = workspace.CurrentCamera
            local rootPos, onScreen = cam:WorldToViewportPoint(root.Position)
            if not onScreen then
                for _, obj in pairs({entry.box, entry.name, entry.dist, entry.hpBg, entry.hp}) do
                    obj.Visible = false
                end
                return
            end

            local headPos = cam:WorldToViewportPoint(head.Position + Vector3.new(0, 0.6, 0))
            local feetPos = cam:WorldToViewportPoint(root.Position - Vector3.new(0, 2.8, 0))

            local boxHeight = math.abs(headPos.Y - feetPos.Y) * 1.05
            local boxWidth = boxHeight * 0.55

            local color = getPlayerColor(player)

            -- Box
            entry.box.Size = Vector2.new(boxWidth, boxHeight)
            entry.box.Position = Vector2.new(rootPos.X - boxWidth/2, rootPos.Y - boxHeight/2)
            entry.box.Color = color
            entry.box.Visible = true

            -- Name
            entry.name.Text = player.Name
            entry.name.Position = Vector2.new(rootPos.X, rootPos.Y - boxHeight/2 - 16)
            entry.name.Color = color
            entry.name.Visible = true

            -- Distance
            local myRoot = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
            local dist = myRoot and (root.Position - myRoot.Position).Magnitude or 0
            entry.dist.Text = string.format("%.0f studs", dist)
            entry.dist.Position = Vector2.new(rootPos.X, rootPos.Y + boxHeight/2 + 2)
            entry.dist.Color = Color3.fromRGB(220,220,220)
            entry.dist.Visible = true

            -- Health bar (di kiri box)
            local hpRatio = math.clamp(humanoid.Health/humanoid.MaxHealth, 0, 1)
            local hpLength = boxHeight * hpRatio

            entry.hpBg.From = Vector2.new(rootPos.X - boxWidth/2 - 6, rootPos.Y - boxHeight/2)
            entry.hpBg.To   = Vector2.new(rootPos.X - boxWidth/2 - 6, rootPos.Y + boxHeight/2)
            entry.hpBg.Visible = true

            entry.hp.From = Vector2.new(rootPos.X - boxWidth/2 - 6, rootPos.Y + boxHeight/2 - hpLength)
            entry.hp.To   = Vector2.new(rootPos.X - boxWidth/2 - 6, rootPos.Y + boxHeight/2)
            entry.hp.Color = Color3.fromHSV(hpRatio * 0.33, 0.9, 1)  -- hijau ke merah
            entry.hp.Visible = true
        end)
    end

    local function removeESP(player)
        local entry = ESP_OBJECTS[player]
        if entry then
            if entry.connection then
                entry.connection:Disconnect()
            end
            for _, obj in pairs({entry.box, entry.name, entry.dist, entry.hpBg, entry.hp}) do
                pcall(function() obj:Remove() end)
            end
            ESP_OBJECTS[player] = nil
        end
    end

    local function refreshAllESP()
        if not ESP_ENABLED then return end
        for _, player in ipairs(Players:GetPlayers()) do
            createOrUpdateESP(player)
        end
    end

    local function toggleESP(enable)
        ESP_ENABLED = enable
        ESP_BUTTON.Text = "Player ESP (" .. (enable and "ON" or "OFF") .. ")"
        ESP_BUTTON.BackgroundColor3 = enable and Color3.fromRGB(60,140,80) or Color3.fromRGB(85,0,0)  -- Ubah ke merah menyala gelap

        if enable then
            refreshAllESP()
        else
            for player, _ in pairs(ESP_OBJECTS) do
                removeESP(player)
            end
            ESP_OBJECTS = {}
        end
    end

    ESP_BUTTON.MouseButton1Click:Connect(function()
        toggleESP(not ESP_ENABLED)
    end)

    -- Player baru join → langsung tambah ESP jika toggle sudah ON
    Players.PlayerAdded:Connect(function(player)
        player.CharacterAdded:Connect(function()
            if ESP_ENABLED then
                createOrUpdateESP(player)
            end
        end)
        -- Juga cek jika karakter sudah ada saat join
        if player.Character and ESP_ENABLED then
            createOrUpdateESP(player)
        end
    end)

    -- Handle existing players saat toggle pertama kali ON
    -- (sudah ditangani di refreshAllESP)

    -- Cleanup saat player keluar
    Players.PlayerRemoving:Connect(removeESP)

    -- Optional: refresh saat character respawn sendiri (untuk distance akurat)
    if lp.Character then
        lp.CharacterAdded:Connect(function()
            task.wait(0.5) -- tunggu spawn
            if ESP_ENABLED then
                refreshAllESP()
            end
        end)
    end

    print("ESP Player FIXED - support player join anytime")
end

