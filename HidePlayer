            fovCircle.Visible = false
        end

        local function checkVisible(char)
            if not wallCheck then return true end
            local part = char:FindFirstChild(targetPart)
            if not part then return false end
            local params = RaycastParams.new()
            params.FilterType = Enum.RaycastFilterType.Blacklist
            params.FilterDescendantsInstances = {lp.Character, char}
            local result = workspace:Raycast(workspace.CurrentCamera.CFrame.Position, part.Position - workspace.CurrentCamera.CFrame.Position, params)
            return result == nil
        end

        local function getAimbotTarget()
            local closest
            local shortest = aimFOV
            local targets = {}
            if targetType == "PLAYER" or targetType == "ALL" then
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= lp and p.Character then table.insert(targets, {Character = p.Character, Player = p}) end
                end
            end
            if targetType == "NPC" or targetType == "ALL" then
                for _, m in ipairs(workspace:GetChildren()) do
                    if m:IsA("Model") and m:FindFirstChild("Humanoid") and not Players:GetPlayerFromCharacter(m) then
                        table.insert(targets, {Character = m, Player = nil})
                    end
                end
            end
            for _, data in ipairs(targets) do
                local char = data.Character
                local plr = data.Player
                if plr and teamCheck and plr.Team == lp.Team then continue end
                local part = char:FindFirstChild(targetPart)
                local hum = char:FindFirstChildOfClass("Humanoid")
                if part and hum and hum.Health > 0 then
                    local pos, onScreen = workspace.CurrentCamera:WorldToViewportPoint(part.Position)
                    if onScreen and checkVisible(char) then
                        local dist = (Vector2.new(pos.X, pos.Y) - Vector2.new(workspace.CurrentCamera.ViewportSize.X/2, workspace.CurrentCamera.ViewportSize.Y/2)).Magnitude
                        if dist < shortest then
                            shortest = dist
                            closest = char
                        end
                    end
                end
            end
            return closest
        end

        RS.RenderStepped:Connect(function()
            if HAS_DRAWING_API and fovCircle then
                fovCircle.Position = Vector2.new(workspace.CurrentCamera.ViewportSize.X/2, workspace.CurrentCamera.ViewportSize.Y/2)
                fovCircle.Radius = aimFOV
                fovCircle.Visible = showFOV
            end
            if not aimbotEnabled then return end
            local target = getAimbotTarget()
            if target then
                local part = target:FindFirstChild(targetPart)
                if part then
                    workspace.CurrentCamera.CFrame = CFrame.new(workspace.CurrentCamera.CFrame.Position, part.Position)
                end
            end
        end)
    end

