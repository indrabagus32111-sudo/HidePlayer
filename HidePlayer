        table.insert(ThemeCore.Toggles, {Btn = ESP_BUTTON, GetState = function() return ESP_ENABLED end})

        local function getPlayerColor(player)
            if player.Team and lp.Team and player.Team == lp.Team then return Color3.fromRGB(80, 255, 80) end
            return Color3.fromRGB(255, 0, 0)
        end

        local function clearESP(player)
            local entry = ESP_OBJECTS[player]
            if entry then
                if HAS_DRAWING_API then
                    pcall(function() entry.box:Remove() entry.name:Remove() end)
                end
                ESP_OBJECTS[player] = nil
            end
            pcall(function()
                if player.Character and player.Character:FindFirstChild("ESPHighlight") then
                    player.Character.ESPHighlight:Destroy()
                end
            end)
        end

        local function updateESP()
            for _, player in ipairs(Players:GetPlayers()) do
                if player == lp then continue end
                
                local char = player.Character
                local root = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChildWhichIsA("BasePart"))

                if not ESP_ENABLED then
                    clearESP(player)
                    continue
                end

                if not char or not char.Parent then
                    local entry = ESP_OBJECTS[player]
                    if entry and HAS_DRAWING_API then
                        entry.box.Visible = false
                        entry.name.Visible = false
                    end
                    continue
                end

                local head = char:FindFirstChild("Head")

                if not root then
                    local entry = ESP_OBJECTS[player]
                    if entry and HAS_DRAWING_API then
                        entry.box.Visible = false
                        entry.name.Visible = false
                    end
                    continue
                end

                local color = getPlayerColor(player)

                local hl = char:FindFirstChild("ESPHighlight")
                if not hl then
                    hl = Instance.new("Highlight")
                    hl.Name = "ESPHighlight"
                    hl.FillTransparency = 0.5
                    hl.OutlineTransparency = 0.1
                    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    hl.Parent = char
                end
                hl.FillColor = color
                hl.OutlineColor = color

                if HAS_DRAWING_API then
                    local entry = ESP_OBJECTS[player]
                    if not entry then
                        local box = Drawing.new("Square")
                        box.Thickness = 2
                        box.Filled = false
                        box.Transparency = 1
                        box.Visible = false

                        local nameTag = Drawing.new("Text")
                        nameTag.Size = 14
                        nameTag.Center = true
                        nameTag.Outline = true
                        nameTag.Font = Drawing.Fonts.UI
                        nameTag.Visible = false

                        entry = {box = box, name = nameTag}
                        ESP_OBJECTS[player] = entry
                    end

                    local cam = workspace.CurrentCamera
                    local rootPos, onScreen = cam:WorldToViewportPoint(root.Position)
                    
                    if onScreen then
                        local topOffset = head and 0.6 or 2
                        local bottomOffset = 2.8
