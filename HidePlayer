local function CreateTab(name, index)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0,90,1,-4)
    btn.Position = UDim2.new(0, 10 + (index-1)*98, 0, 2)
    btn.BackgroundColor3 = Color3.fromRGB(55,0,0)  -- Ubah ke merah menyala gelap
    btn.BackgroundTransparency = 0.5
    btn.Text = name
    btn.TextColor3 = Color3.fromRGB(255,210,210)  -- Tetap
    btn.Font = Enum.Font.GothamSemibold
    btn.TextSize = 15
    btn.Parent = TabFrame

    local corner = Instance.new("UICorner", btn)
    corner.CornerRadius = UDim.new(0,7)

    local content = Instance.new("Frame")
    content.Size = UDim2.new(1,-16,1,-90)
    content.Position = UDim2.new(0,8,0,80)
    content.BackgroundTransparency = 1
    content.Visible = false
    content.Parent = MainFrame

    table.insert(tabButtons, btn)
    table.insert(tabContents, content)

    btn.MouseButton1Click:Connect(function()
        for _, c in ipairs(tabContents) do c.Visible = false end
        content.Visible = true
        for _, b in ipairs(tabButtons) do
            TS:Create(b, TweenInfo.new(0.2), {BackgroundTransparency = 0.5, TextColor3 = Color3.fromRGB(255,210,210)}):Play()
        end
        TS:Create(btn, TweenInfo.new(0.2), {BackgroundTransparency = 0.2, TextColor3 = Color3.fromRGB(255,255,255)}):Play()
    end)

    return content
end

