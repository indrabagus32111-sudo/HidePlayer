local function getHighlightAdornee(target, fallback)
    if target and (target:IsA("Model") or target:IsA("BasePart")) then
        return target
    end
    if target and target:IsA("ProximityPrompt") then
        local model = target:FindFirstAncestorOfClass("Model")
        if model then
            return model
        end
        local part = target.Parent and (target.Parent:IsA("BasePart") and target.Parent or target:FindFirstAncestorWhichIsA("BasePart"))
        if part then
            return part
        end
    end
    if target and target:IsA("Attachment") then
        local parent = target.Parent
        if parent and parent:IsA("BasePart") then
            return parent
        end
    end
    return fallback
end

local function updateEsp(id, object, highlightTarget, text, color)
    pcall(function()
        if not object or not object.Parent then
            removeEsp(id)
            return
        end

        local anchor = getAnchor(object)
        if not anchor or not anchor.Parent then
            removeEsp(id)
            return
        end

        if anchor:IsA("Attachment") then
            local parent = anchor.Parent
            if not parent or not parent:IsA("BasePart") then
                removeEsp(id)
                return
            end
        elseif not anchor:IsA("BasePart") then
            removeEsp(id)
            return
        end

        local highlightAdornee = getHighlightAdornee(highlightTarget, anchor)
        if not highlightAdornee or not highlightAdornee.Parent then
            highlightAdornee = anchor
        end
        if not (highlightAdornee:IsA("Model") or highlightAdornee:IsA("BasePart")) then
            highlightAdornee = anchor
        end

        text = tostring(text or "Unknown Item")
        color = typeof(color) == "Color3" and color or Color3.new(1, 1, 1)

        local old = ActiveEsp[id]
        if old and old.Anchor == anchor and old.Target == highlightAdornee and old.Billboard and old.Billboard.Parent and old.Highlight and old.Highlight.Parent then
            if old.Text ~= text then
                old.Text = text
                old.Label.Text = text
            end
            if old.Color ~= color then
                old.Color = color
                old.Label.TextColor3 = color
                old.Highlight.FillColor = color
                old.Highlight.OutlineColor = color
            end
            return
        end

        removeEsp(id)

        local billboard = Instance.new("BillboardGui")
        billboard.Name = "ItemESP_Billboard"
        billboard.Adornee = anchor
        billboard.Size = UDim2.fromOffset(220, 24)
        billboard.StudsOffset = Vector3.new(0, 1.8, 0)
        billboard.AlwaysOnTop = true
        billboard.MaxDistance = 10000
        billboard.Parent = EspGui

        local label = Instance.new("TextLabel")
        label.Name = "ItemName"
        label.BackgroundTransparency = 1
        label.Size = UDim2.fromScale(1, 1)
        label.Font = Enum.Font.GothamBold
        label.TextSize = 13
        label.TextColor3 = color
        label.TextStrokeColor3 = Color3.new(0, 0, 0)
        label.TextStrokeTransparency = 0
