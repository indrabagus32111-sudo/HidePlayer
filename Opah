    local seenKeys = {}
    local items = Workspace:FindFirstChild("PuzzleItems")
    if items then
        for _, item in ipairs(items:GetChildren()) do
            local itemType = tostring(item:GetAttribute("ItemType") or "")
            local attrColor = normalizeColor(item:GetAttribute("KeyColor"))
            if itemType:lower() == "key" or attrColor or item.Name:lower():find("key", 1, true) then
                seenKeys[item] = true
                table.insert(data.keys, {
                    target = item,
                    color = attrColor or normalizeColor(findKeyColorName(item.Name)),
                    prompt = findPromptNear(item)
                })
            end
        end
    end

    for _, prompt in ipairs(Tracked.Keys) do
        if prompt and prompt.Parent then
            local model = prompt:FindFirstAncestorOfClass("Model") or prompt.Parent
            if not seenKeys[model] and not seenKeys[prompt] then
                seenKeys[prompt] = true
                local disp = getDisplayName(prompt, model.Name)
                table.insert(data.keys, {
                    target = model,
                    color = normalizeColor(model:GetAttribute("KeyColor"))
                        or normalizeColor(findKeyColorName(disp))
                        or normalizeColor(findKeyColorName(prompt.ObjectText))
                        or normalizeColor(findKeyColorName(prompt.ActionText)),
                    prompt = prompt
                })
            end
        end
    end

    return data
end

