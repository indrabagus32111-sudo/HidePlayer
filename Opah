local AutoStartReadySince = nil
local AUTO_START_CHECK_INTERVAL = 0.25
local AUTO_START_STABLE_TIME = 0.8

local function isAutoStartReady()
    local character = LocalPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local frontDoor = Workspace:FindFirstChild("FrontDoor")
    local puzzleItems = Workspace:FindFirstChild("PuzzleItems")
    local introPhase = Workspace:GetAttribute("IntroPhase")
    local hasKeysOrLocks = (frontDoor and frontDoor:FindFirstChild("PuzzleLocks") ~= nil) or (puzzleItems ~= nil)

    return root ~= nil
        and root.Parent ~= nil
        and humanoid ~= nil
        and humanoid.Health > 0
        and frontDoor ~= nil
        and puzzleItems ~= nil
        and hasKeysOrLocks
        and (introPhase == "Done" or introPhase == nil)
end

task.spawn(function()
    local startWaitDeadline = os.clock() + 45
    while Running do
        task.wait(AUTO_START_CHECK_INTERVAL)

        if not State.AutoStart or AutoStartTriggered or KKG.farm then
            AutoStartReadySince = nil
        elseif isAutoStartReady() then
            AutoStartReadySince = AutoStartReadySince or os.clock()
            if (os.clock() - AutoStartReadySince >= AUTO_START_STABLE_TIME) or (os.clock() >= startWaitDeadline) then
                AutoStartTriggered = true
                AutoStartReadySince = nil
                pcall(function()
                    if AutoToggleRefs.ending and type(AutoToggleRefs.ending.Set) == "function" then
                        AutoToggleRefs.ending:Set(true)
                    elseif AutoToggleRefs.ending and type(AutoToggleRefs.ending.SetValue) == "function" then
                        AutoToggleRefs.ending:SetValue(true)
                    end
                end)
                fTriggerRun("ending")
            end
        else
            AutoStartReadySince = nil
        end
    end
end)

