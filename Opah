        if State.EspLamp then
            for _, prompt in ipairs(Tracked.Lamps) do
                if prompt and prompt.Parent then
                    local position = getPosition(prompt)
                    if position then
                        local name = getDisplayName(prompt, "Lamp")
                        local label = name .. " [" .. getDistance(position) .. "m]"
                        local color = Color3.fromRGB(255, 235, 70)
                        local lit = false
                        for code in pairs(LitLamps) do
