local function isPureDigitText(raw)
    local compact = tostring(raw or ""):gsub("%s", "")
    if compact:match("^%d+$") and #compact >= 3 and #compact <= 6 then
        return compact
    end
    return nil
end

local function findPasscode()
    local ok, found = pcall(function()
        local namedText = nil
        local namedValue = nil
        local fallbackText = nil

        for d in pairs(Index.passText) do
            if d and d.Parent then
                if d:IsA("TextLabel") or d:IsA("TextBox") then
                    local t = isPureDigitText(d.Text)
                    if t then
                        if nameHasPassWord(d) then
                            namedText = namedText or t
                        elseif not fallbackText and (d:FindFirstAncestorWhichIsA("SurfaceGui") or d:FindFirstAncestorWhichIsA("BillboardGui")) then
                            fallbackText = t
                        end
                    end
                elseif d:IsA("ValueBase") and nameHasPassWord(d) then
                    local t = isPureDigitText(d.Value)
                    if t then
                        namedValue = namedValue or t
                    end
                end
            end
        end

        if namedText then
            return namedText
        end
        if namedValue then
            return namedValue
        end

        local puzzleItems = Workspace:FindFirstChild("PuzzleItems")
        local note = puzzleItems and puzzleItems:FindFirstChild("PasscodeNote")
        if note then
            for _, desc in ipairs(note:GetDescendants()) do
                if desc:IsA("TextLabel") or desc:IsA("TextBox") then
                    local t = isPureDigitText(desc.Text)
                    if t then
                        return t
                    end
                end
            end
        end

        return fallbackText
    end)
    return ok and found or nil
end

local function addUnique(list, item)
    if not item then
        return
    end
    for _, existing in ipairs(list) do
        if existing == item then
            return
        end
    end
    table.insert(list, item)
end

local function registerObject(object)
    if not object then
        return
    end
    pcall(function()
        if object:IsA("ProximityPrompt") then
            local objectText = cleanText(object.ObjectText)
            local actionText = cleanText(object.ActionText)
            local parentName = object.Parent and cleanText(object.Parent.Name) or ""
            local model = object:FindFirstAncestorOfClass("Model")
            local modelName = model and cleanText(model.Name) or ""
            local lower = objectText:lower()

            if lower:find("keypad", 1, true)
                or actionText:lower():find("keypad", 1, true)
                or parentName:lower():find("keypad", 1, true)
                or modelName:lower():find("keypad", 1, true) then
                Tracked.Keypad = object
            elseif lower:find("key", 1, true)
                or actionText:lower():find("key", 1, true)
                or parentName:lower():find("key", 1, true)
                or modelName:lower():find("key", 1, true)
                or (model and model:GetAttribute("ItemType") == "Key")
                or (model and model:GetAttribute("KeyColor") ~= nil) then
                addUnique(Tracked.Keys, object)
            elseif lower:find("passcode", 1, true)
                or objectText == "Passcode Note"
                or modelName:lower():find("passcode", 1, true)
                or parentName:lower():find("passcode", 1, true) then
                Tracked.Note = object
            elseif lower:find("padlock", 1, true)
                or actionText:find("Padlock", 1, true)
                or lower:find("lock", 1, true)
                or parentName:lower():find("lock", 1, true)
                or modelName:lower():find("lock", 1, true) then
                addUnique(Tracked.Locks, object)
            elseif lower:find("pelita", 1, true) then
                addUnique(Tracked.Lamps, object)
            elseif objectText == "Music Box" or (actionText == "Listen" and object:FindFirstAncestor("KotakMuzik")) then
                Tracked.MusicBox = object
            elseif objectText == "Old Photo" then
                Tracked.Photo = object
            end
        elseif object:IsA("BasePart") or object:IsA("Model") then
            local parent = object.Parent
            if parent and parent.Name == "HidingWardrobes" then
                local part = object:IsA("Model")
                    and (object.PrimaryPart or object:FindFirstChildWhichIsA("BasePart", true))
                    or object
                if part then
                    table.insert(Tracked.Wardrobes, { Part = part, Model = object })
                end
            elseif parent and parent.Name == "FlipFlops" then
                local part = object:IsA("Model")
                    and (object.PrimaryPart or object:FindFirstChildWhichIsA("BasePart", true))
                    or object
                if part then
                    table.insert(Tracked.FlipFlops, { Part = part, Model = object })
                end
            end
        end
    end)
end

