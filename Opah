local function nearby(radius)
    local result = { prompts = {}, clicks = {} }
    local hrp = getHrp()
    if not hrp then return result end

    local promptRadius = math.max(tonumber(radius) or 12, 0)
    for _, inst in ipairs(Workspace:GetDescendants()) do
        if inst:IsA("ProximityPrompt") then
            local part = inst.Parent
            if part and not part:IsA("BasePart") then
                part = inst:FindFirstAncestorWhichIsA("BasePart")
            end
            if part and (part.Position - hrp.Position).Magnitude <= promptRadius then
                table.insert(result.prompts, { inst = inst })
            end
        elseif inst:IsA("ClickDetector") then
            local part = getClickDetectorPart(inst)
            clampClickDetectorDistance(inst)
            if part and isClickDetectorInRange(inst, part) then
                table.insert(result.clicks, { inst = inst, part = part })
            end
        end
    end

    return result
end

local function firePrompt(pp)
    if not pp or not pp.Parent then return end
    pcall(function() pp.HoldDuration = 0 end)
    pcall(function() pp.RequiresLineOfSight = false end)
    pcall(function() pp.MaxActivationDistance = math.max(pp.MaxActivationDistance, 30) end)
    if fireproximityprompt then
        pcall(fireproximityprompt, pp)
    else
        pcall(function()
            pp:InputHoldBegin()
            task.wait(0.1)
            pp:InputHoldEnd()
        end)
    end
end

local function fireNearby(radius)
    local r = nearby(radius)
    local n = 0
    for _, e in ipairs(r.prompts) do
        if e.inst and e.inst.Parent and e.inst.Enabled then
            firePrompt(e.inst)
            n = n + 1
        end
    end
    if type(fireclickdetector) == "function" then
        for _, e in ipairs(r.clicks) do
            local detector = e.inst
            local part = e.part
            local ok, fired = pcall(function()
                if not isClickDetectorInRange(detector, part) then
                    return false
                end
                fireclickdetector(detector)
                return true
            end)
            if ok and fired then
                n = n + 1
            end
        end
    end
    return n
end

