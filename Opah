                            Model = item.Model,
                            Distance = getDistance(position)
                        })
                    end
                end
            end
            table.sort(list, function(a, b)
                return a.Distance < b.Distance
            end)
            for index = 1, math.min(3, #list) do
                local item = list[index]
                used[item.Part] = true
