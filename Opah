local function cleanText(value)
    local text = tostring(value or "")
    text = text:gsub("\u{200B}", ""):gsub("\u{FE0F}", ""):gsub("%s+", " ")
    return text:match("^%s*(.-)%s*$") or ""
end

local function getRoot()
    local character = LocalPlayer.Character
    return character and character:FindFirstChild("HumanoidRootPart")
end

local function getAnchor(object)
    if not object then
        return nil
    end
    if object:IsA("BasePart") or object:IsA("Attachment") then
        return object
    end
    if object:IsA("ProximityPrompt") then
        local parent = object.Parent
        if parent and (parent:IsA("BasePart") or parent:IsA("Attachment")) then
            return parent
        end
        local part = object:FindFirstAncestorWhichIsA("BasePart")
        if part then
            return part
        end
    end
    if object:IsA("Model") then
        return object.PrimaryPart or object:FindFirstChildWhichIsA("BasePart", true)
    end
    local model = object:FindFirstAncestorOfClass("Model")
    if model then
        return model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true)
    end
    return nil
end

local function getPosition(object)
    local anchor = getAnchor(object)
    if not anchor then
        return nil
    end
    if anchor:IsA("Attachment") then
        return anchor.WorldPosition
    end
    return anchor.Position
end

local function getDistance(position)
    local root = getRoot()
    if not root or not position then
        return 0
    end
    return math.floor((position - root.Position).Magnitude)
end

local function getDisplayName(prompt, fallback)
    if prompt and prompt:IsA("ProximityPrompt") then
        local objectText = cleanText(prompt.ObjectText)
        local actionText = cleanText(prompt.ActionText)
        if objectText ~= "" then
            return objectText
        end
        if actionText ~= "" then
            return actionText
        end
    end
    local model = prompt and prompt:FindFirstAncestorOfClass("Model")
    if model and cleanText(model.Name) ~= "" then
        return cleanText(model.Name)
    end
    if prompt and prompt.Parent and cleanText(prompt.Parent.Name) ~= "" then
        return cleanText(prompt.Parent.Name)
    end
    return fallback or "Unknown Item"
end

