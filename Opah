local function triggerSkipCutscene()
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    local cutsceneGui = playerGui and playerGui:FindFirstChild("CutsceneGui")
    local skipButton = cutsceneGui and cutsceneGui:FindFirstChild("SkipButton")

    if not skipButton then
        return false
    end

    local visible = false
    local active = false

    pcall(function()
        visible = skipButton.Visible
        active = skipButton.Active
    end)

    if not visible or not active or type(getconnections) ~= "function" then
        return false
    end

    local ok, connections = pcall(getconnections, skipButton.Activated)
    if not ok or type(connections) ~= "table" then
        return false
    end

    local fired = false
    for _, conn in ipairs(connections) do
        pcall(function()
            if conn and type(conn.Fire) == "function" then
                conn:Fire()
                fired = true
            end
        end)
    end

    return fired
end

