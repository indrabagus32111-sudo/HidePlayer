local function normalizeColor(val)
    if not val then return nil end
    local s = tostring(val):lower():gsub("%s+", "")
    return s ~= "" and s or nil
end

local function fRoot()
    local character = LocalPlayer.Character
    return character and character:FindFirstChild("HumanoidRootPart")
end

local function fPosOf(inst)
    if not inst then return nil end
    if typeof(inst) == "Vector3" then return inst end
    if inst:IsA("ProximityPrompt") then
        return getPosition(inst)
    end
    if inst:IsA("BasePart") then return inst.Position end
    if inst:IsA("Attachment") then return inst.WorldPosition end
    if inst:IsA("Model") then
        if inst.PrimaryPart then return inst.PrimaryPart.Position end
        local ok, pivot = pcall(function() return inst:GetPivot() end)
        if ok and pivot then return pivot.Position end
    end
    local part = inst:FindFirstChildWhichIsA("BasePart", true)
    return part and part.Position
end

local function findPromptNear(target)
    if not target then return nil end
    if target:IsA("ProximityPrompt") then return target end
    local direct = target:FindFirstChildWhichIsA("ProximityPrompt", true)
    if direct then return direct end
    local model = target:IsA("Model") and target or target:FindFirstAncestorOfClass("Model")
    if model then
        return model:FindFirstChildWhichIsA("ProximityPrompt", true)
    end
    return nil
end

local function fMoveTo(targetPos, reachDist)
    if typeof(targetPos) ~= "Vector3" then return false end
    KKG.moveId = KKG.moveId + 1
    local id = KKG.moveId
    local root = fRoot()
    if not root then return false end

    local dist = (targetPos - root.Position).Magnitude
    local limit = math.max(dist / math.max(KKG.moveSpeed, 1) * 2.5 + 4, 5)
    local t0 = os.clock()

    while KKG.farm and KKG.moveId == id and (os.clock() - t0) < limit do
        root = fRoot()
        if not root then return false end
        local diff = targetPos - root.Position
        local mag = diff.Magnitude
        if mag <= (reachDist or 1.35) then
            root.AssemblyLinearVelocity = Vector3.zero
            return true
        end
        local dt = math.min(RunService.Heartbeat:Wait(), KKG.moveStep)
        root.AssemblyLinearVelocity = Vector3.zero
        local stepDist = math.min(mag, KKG.moveSpeed * dt)
        root.CFrame = CFrame.new(root.Position + diff.Unit * stepDist) * (root.CFrame - root.CFrame.Position)
    end
    return false
end

local function fFirePrompt(prompt)
    if not prompt or not prompt.Parent then return false end
    pcall(function()
        prompt.Enabled = true
        prompt.HoldDuration = 0
        prompt.RequiresLineOfSight = false
        if prompt.MaxActivationDistance < 30 then
            prompt.MaxActivationDistance = 30
        end
    end)

    local fired = false
    pcall(function()
        if type(fireproximityprompt) == "function" then
            fireproximityprompt(prompt)
            fired = true
        end
    end)
    return fired
end

