                        end
                        used[prompt] = true
                        updateEsp(prompt, prompt, prompt:FindFirstAncestorOfClass("Model"), label, color)
                    end
                end
            end

            if Tracked.MusicBox and Tracked.MusicBox.Parent then
                local object = Tracked.MusicBox
                local position = getPosition(object)
                if position then
                    used.MusicBox = true
                    updateEsp(
                        "MusicBox",
                        object,
                        object:FindFirstAncestorOfClass("Model"),
                        "Music Box [" .. getDistance(position) .. "m]",
                        Color3.fromRGB(255, 255, 255)
                    )
                end
            end

            if Tracked.Photo and Tracked.Photo.Parent then
                local object = Tracked.Photo
                local position = getPosition(object)
                if position then
                    used.Photo = true
                    updateEsp(
                        "Photo",
                        object,
                        object:FindFirstAncestorOfClass("Model"),
                        "Old Photo [" .. getDistance(position) .. "m]",
                        Color3.fromRGB(255, 190, 120)
                    )
                end
            end
        end

        if State.EspOpah then
            local opah = Workspace:FindFirstChild("Opah")
            local root = opah and (
                opah:FindFirstChild("HumanoidRootPart")
                or opah:FindFirstChildWhichIsA("BasePart", true)
            )
            if root then
                used.Opah = true
                updateEsp(
                    "Opah",
                    root,
                    opah,
                    "OPAH [" .. getDistance(root.Position) .. "m]",
                    Color3.fromRGB(255, 40, 40)
                )
            end
        end

        if State.EspPlayer then
            for _, player in ipairs(Players:GetPlayers()) do
                if player ~= LocalPlayer then
                    local character = player.Character
                    local root = character and character:FindFirstChild("HumanoidRootPart")
                    if root then
                        used[player] = true
                        updateEsp(
                            player,
                            root,
                            character,
                            player.Name .. " [" .. getDistance(root.Position) .. "m]",
                            Color3.fromRGB(70, 255, 90)
                        )
                    end
                end
            end
        end

        for id in pairs(ActiveEsp) do
            if not used[id] then
                removeEsp(id)
            end
        end

        task.wait(math.clamp(tonumber(State.UpdateDelay) or 0.5, 0.1, 5))
    end
end)

