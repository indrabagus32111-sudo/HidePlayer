        highlight.OutlineColor = color
        highlight.FillTransparency = 0.7
        highlight.OutlineTransparency = 0
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.Parent = EspGui

        ActiveEsp[id] = {
            Billboard = billboard,
            Label = label,
            Highlight = highlight,
            Anchor = anchor,
            Target = highlightAdornee,
            Text = text,
            Color = color
        }
    end)
end

local KeyColors = {
    Red = Color3.fromRGB(255, 70, 70),
    Blue = Color3.fromRGB(70, 140, 255),
    Green = Color3.fromRGB(70, 255, 90),
    Yellow = Color3.fromRGB(255, 235, 70),
    Purple = Color3.fromRGB(190, 100, 255),
    Orange = Color3.fromRGB(255, 155, 45),
    Pink = Color3.fromRGB(255, 110, 180),
    Cyan = Color3.fromRGB(65, 235, 255),
    White = Color3.fromRGB(240, 240, 240)
}

local function findKeyColorName(value)
    local text = cleanText(value):lower()
    if text == "" then
        return nil
    end
    for colorName in pairs(KeyColors) do
        if text:find(colorName:lower(), 1, true) then
            return colorName
        end
    end
    if text:find("merah", 1, true) then return "Red" end
    if text:find("biru", 1, true) then return "Blue" end
    if text:find("hijau", 1, true) then return "Green" end
    if text:find("kuning", 1, true) then return "Yellow" end
    if text:find("ungu", 1, true) then return "Purple" end
    if text:find("oren", 1, true) or text:find("jingga", 1, true) then return "Orange" end
    if text:find("merah muda", 1, true) or text:find("pink", 1, true) then return "Pink" end
    if text:find("cyan", 1, true) or text:find("toska", 1, true) then return "Cyan" end
    return nil
end

local function detectColorFromPrompt(prompt, defaultColor)
    if not prompt then
        return defaultColor, nil
    end
    local ok, col, cname = pcall(function()
        local model = prompt:FindFirstAncestorOfClass("Model")
        local part = prompt.Parent and (prompt.Parent:IsA("BasePart") and prompt.Parent or prompt:FindFirstAncestorWhichIsA("BasePart"))

        local attrColor = prompt:GetAttribute("KeyColor")
            or (part and part:GetAttribute("KeyColor"))
            or (model and model:GetAttribute("KeyColor"))

        local colorName = findKeyColorName(attrColor)
            or findKeyColorName(prompt.ObjectText)
            or findKeyColorName(prompt.ActionText)
            or findKeyColorName(part and part.Name)
            or findKeyColorName(model and model.Name)

        local current = prompt.Parent
        while current and current ~= Workspace and not colorName do
            colorName = findKeyColorName(current:GetAttribute("KeyColor")) or findKeyColorName(current.Name)
            current = current.Parent
        end

        if colorName and KeyColors[colorName] then
            return KeyColors[colorName], colorName
        end

        local root = model or part
        local closestColor
        local closestDifference = math.huge
        if root then
            for _, descendant in ipairs(root:GetDescendants()) do
                if descendant:IsA("BasePart") then
                    local partColor = descendant.Color
                    for name, keyColor in pairs(KeyColors) do
                        local difference =
                            math.abs(partColor.R - keyColor.R) +
                            math.abs(partColor.G - keyColor.G) +
                            math.abs(partColor.B - keyColor.B)
                        if difference < closestDifference then
                            closestDifference = difference
                            closestColor = name
                        end
                    end
                end
            end
        end

        if closestColor and closestDifference < 0.9 and KeyColors[closestColor] then
            return KeyColors[closestColor], closestColor
        end

        return defaultColor, colorName
    end)

    if ok and col then
        return col, cname
    end
    return defaultColor, nil
end

local function getKeyColor(prompt)
    return detectColorFromPrompt(prompt, Color3.fromRGB(255, 235, 70))
end

