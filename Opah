local function getClickDetectorPart(detector)
    if not detector then return nil end
    local part = detector.Parent
    if part and part:IsA("BasePart") then
        return part
    end
    return detector:FindFirstAncestorWhichIsA("BasePart")
end

local function clampClickDetectorDistance(detector)
    if not detector or not detector:IsA("ClickDetector") then
        return
    end
    pcall(function()
        detector.MaxActivationDistance = CLICK_DETECTOR_RADIUS
    end)
end

local function isClickDetectorInRange(detector, part)
    if not detector or not detector:IsA("ClickDetector") or not detector.Parent then
        return false
    end
    if not part or not part:IsA("BasePart") or not part.Parent then
        return false
    end
    local hrp = getHrp()
    if not hrp or not hrp.Parent then
        return false
    end
    local distance = (part.Position - hrp.Position).Magnitude
    return distance <= CLICK_DETECTOR_RADIUS
end

