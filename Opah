local function fScanPuzzleData()
    local data = { keys = {}, locks = {} }
    local frontDoor = Workspace:FindFirstChild("FrontDoor")
    local locks = frontDoor and frontDoor:FindFirstChild("PuzzleLocks")
    if locks then
        for _, lock in ipairs(locks:GetChildren()) do
            local color = normalizeColor(lock:GetAttribute("KeyColor"))
                or normalizeColor(findKeyColorName(lock.Name))
            local prompt = findPromptNear(lock)
            if color and prompt then
                data.locks[color] = prompt
            end
