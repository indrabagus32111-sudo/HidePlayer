                )
            end
        end

        if State.EspWardNear then
            local nearest
            local nearestDistance
            for _, item in ipairs(Tracked.Wardrobes) do
                if item.Part and item.Part.Parent then
                    local position = getPosition(item.Part)
                    if position then
                        local distance = getDistance(position)
                        if not nearestDistance or distance < nearestDistance then
                            nearest = item
                            nearestDistance = distance
                        end
                    end
                end
            end
            if nearest then
                used.WardrobeNearest = true
                updateEsp(
                    "WardrobeNearest",
                    nearest.Part,
                    nearest.Model,
                    "Nearest Wardrobe [" .. nearestDistance .. "m]",
