local function waitUntilCondition(checkFn, timeout, jobKey)
    local deadline = os.clock() + (timeout or 2)
    while KKG.farm == jobKey and os.clock() < deadline do
        if checkFn() then
            return true
        end
        task.wait(0.15)
    end
    return checkFn()
end

local function fVisit(target, waitTime, checkFn, jobKey)
    local pos = fPosOf(target)
    if not pos then return false end
    local prompt = findPromptNear(target)
    if not fMoveTo(pos + Vector3.new(0, 1.5, 0), 1.6) then return false end

    if prompt then
        for _ = 1, 3 do
            if jobKey and KKG.farm ~= jobKey then return false end
            if checkFn and checkFn() then break end
            fFirePrompt(prompt)
            task.wait(0.25)
        end
    end

    if checkFn and jobKey then
        waitUntilCondition(checkFn, waitTime or 1.2, jobKey)
    else
        task.wait(waitTime or 0.7)
    end
    return true
end

