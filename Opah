local KEY_STOP_DURATION = 0.3

local function collectKeyEntry(entry, jobKey)
    if KKG.farm ~= jobKey then
        return false
    end

    local target = entry and entry.target
    local prompt = (entry and entry.prompt) or findPromptNear(target)
    if not target or not prompt or not prompt.Parent then
        return false
    end

    local color = entry.color
    local initialKeyCount = keyToolCount()
    local keyPos = fPosOf(prompt) or fPosOf(target)
    if not keyPos then
        return false
    end

    if not fMoveTo(keyPos + Vector3.new(0, 1.0, 0), 1.4) then
        return false
    end

    local keyPart = getKeyTouchPart(target, prompt)

    local function isCollected()
        return hasKeyInInventory(color) or keyToolCount() > initialKeyCount
    end

    if isCollected() then
        return true
    end

    for attempt = 1, 6 do
        if KKG.farm ~= jobKey then
            return false
        end

        if isCollected() then
            return true
        end

        if not prompt.Parent then
            local disappearanceDeadline = os.clock() + KEY_STOP_DURATION
            while KKG.farm == jobKey and os.clock() < disappearanceDeadline do
                if isCollected() then
                    return true
                end
                task.wait(0.1)
            end
            return isCollected()
        end

        local currentRoot = fRoot()
        local currentPromptPos = fPosOf(prompt)
        if currentRoot and currentPromptPos
            and (currentRoot.Position - (currentPromptPos + Vector3.new(0, 1.0, 0))).Magnitude > 3 then
            if not fMoveTo(currentPromptPos + Vector3.new(0, 1.0, 0), 1.4) then
                return false
            end
        end

        trigger(target, keyPart, 12)

        local pickupDeadline = os.clock() + KEY_STOP_DURATION
        while KKG.farm == jobKey and os.clock() < pickupDeadline do
            if isCollected() then
                return true
            end
            task.wait(0.05)
        end

        if KKG.farm ~= jobKey then
            return false
        end

        if isCollected() then
            return true
        end

        if not prompt.Parent then
            return false
        end
    end

    return isCollected()
end

local function fAutoEndingJob(jobKey)
    if Workspace:GetAttribute("IntroPhase") ~= "Done" then
        local t0 = os.clock()
        repeat
            task.wait(0.25)
        until KKG.farm ~= jobKey or Workspace:GetAttribute("IntroPhase") == "Done" or (os.clock() - t0) > 120
    end
    if KKG.farm ~= jobKey then return end

    local data = fScanPuzzleData()
    local unlocked = {}

    for _, entry in ipairs(data.keys) do
        if KKG.farm ~= jobKey then return end
        local color = entry.color
        if color and unlocked[color] then
            continue
        end

        local pickedUp = collectKeyEntry(entry, jobKey)
        if KKG.farm ~= jobKey then return end

        if pickedUp and color then
            local currentData = fScanPuzzleData()
            local lockPrompt = data.locks[color] or currentData.locks[color]
            local lockPos = lockPrompt and fPosOf(lockPrompt)
            if lockPrompt and lockPos then
                local targetLockPos = lockPos + Vector3.new(0, 1, -2.5)
                fMoveTo(targetLockPos, 1.7)
                local prevRem = fGetLocksRemaining()
                for _ = 1, 4 do
                    if KKG.farm ~= jobKey then return end
                    fFirePrompt(lockPrompt)
                    task.wait(0.3)
                    if fGetLocksRemaining() < prevRem then
                        break
                    end
                    fMoveTo(targetLockPos, 1.4)
                end
                unlocked[color] = true
            end
        end
    end

    if fGetLocksRemaining() > 0 then
        local t0 = os.clock()
        repeat
            task.wait(0.25)
        until KKG.farm ~= jobKey or fGetLocksRemaining() <= 0 or (os.clock() - t0) > 25
    end

    if KKG.farm == jobKey then
        local digits = fGetPasscodeDigits()
        if digits and digits ~= "" then
            local frontDoor = Workspace:FindFirstChild("FrontDoor")
            local keypad = frontDoor and frontDoor:FindFirstChild("Keypad")
            local plate = keypad and keypad:FindFirstChild("Plate")
            local platePos = fPosOf(plate) or fPosOf(keypad)
            if platePos then
                fMoveTo(platePos + Vector3.new(0, 1, -2.5), 1.7)
                local padPrompt = findPromptNear(keypad)
                if padPrompt then
                    fFirePrompt(padPrompt)
                    task.wait(0.2)
                end
            end

            local submit = findSubmitPasscodeRemote()
            if submit then
                pcall(function()
                    submit:InvokeServer(digits)
                end)
            end

            task.wait(1.5)
            local cutscenes = Workspace:FindFirstChild("Cutscenes")
            local markers = cutscenes and cutscenes:FindFirstChild("Markers")
            local bikePos = fPosOf(markers and markers:FindFirstChild("BikePark"))
            if bikePos then
                fMoveTo(bikePos + Vector3.new(0, 3, 0), 2)
            end
        end
    end
end

local function runAutoPlayMusic(token)
    local secretEnding = Workspace:FindFirstChild("SecretEnding") or Workspace:WaitForChild("SecretEnding", 8)
    if not secretEnding then return end

    local kotakMuzik = secretEnding:FindFirstChild("KotakMuzik")
    if not kotakMuzik then return end

    local boxPrompt = findPromptNear(kotakMuzik:FindFirstChild("Box") or kotakMuzik)
    local keys = {}
    local keyPrompts = {}

    for i = 1, 4 do
        local keyPart = kotakMuzik:FindFirstChild("Key_" .. i)
        if keyPart then
            keys[i] = keyPart
            keyPrompts[i] = findPromptNear(keyPart)
        end
    end

    local melodyLength = 5
    local noteGap = 0.9
    pcall(function()
        local secretShared = ReplicatedStorage:FindFirstChild("SecretShared")
        local cfgModule = secretShared and secretShared:FindFirstChild("SecretConfig")
        if cfgModule and cfgModule:IsA("ModuleScript") then
            local cfg = require(cfgModule)
            melodyLength = tonumber(cfg.MelodyLength) or melodyLength
            noteGap = (tonumber(cfg.NoteGap) or 0.8) + 0.1
        end
    end)

    local function isKeyLit(index)
        local part = keys[index]
        return part and part.Material == Enum.Material.Neon or false
    end

    local function areAllKeysLit()
        for i = 1, 4 do
            if not isKeyLit(i) then return false end
        end
        return true
    end

    local function areAllKeysStopped()
        for i = 1, 4 do
            if isKeyLit(i) then return false end
        end
        return true
    end

    local function waitUntil(checkFn, timeout)
        local deadline = os.clock() + (timeout or 2)
        while KKG.farm == token and os.clock() < deadline do
            if checkFn() then return true end
            task.wait(0.05)
        end
        return checkFn()
    end

    local attempts = 0
    while KKG.farm == token and (Workspace:GetAttribute("SecretStage") == 2 or tonumber(Workspace:GetAttribute("SecretStage")) == 2) and attempts < 12 do
        attempts = attempts + 1

        local recorded = {}
        local lastNoteTime = os.clock()
        local connections = {}

        for i = 1, 4 do
            local part = keys[i]
            if part then
                table.insert(connections, part:GetPropertyChangedSignal("Material"):Connect(function()
                    if not isKeyLit(i) then return end
                    task.delay(0.1, function()
                        if isKeyLit(i) and not areAllKeysLit() then
                            lastNoteTime = os.clock()
                            table.insert(recorded, i)
                        end
                    end)
                end))
            end
        end

        local lastListenTime = -10
        local listenDeadline = os.clock() + 25

        while KKG.farm == token and (Workspace:GetAttribute("SecretStage") == 2 or tonumber(Workspace:GetAttribute("SecretStage")) == 2)
            and #recorded < melodyLength and os.clock() < listenDeadline do

            if #recorded > 0 and (os.clock() - lastNoteTime) > 2.5 then
                table.clear(recorded)
                lastListenTime = -10
            end

            if #recorded == 0 and (os.clock() - lastListenTime) > 3 then
                local boxPos = fPosOf(boxPrompt or kotakMuzik:FindFirstChild("Box") or kotakMuzik)
                if boxPos and boxPrompt then
                    fMoveTo(boxPos + Vector3.new(0, 2.5, 0), 1.6)
                    fFirePrompt(boxPrompt)
                    lastListenTime = os.clock()
                end
            end

            task.wait(0.05)
        end

        for _, conn in ipairs(connections) do
            conn:Disconnect()
        end

        if #recorded >= melodyLength and (Workspace:GetAttribute("SecretStage") == 2 or tonumber(Workspace:GetAttribute("SecretStage")) == 2) then
            waitUntil(areAllKeysStopped, 2)
            task.wait(0.3)

            local function pressKeyUntilPlayed(keyIndex)
                local prompt = keyPrompts[keyIndex]
                local pos = fPosOf(prompt or keys[keyIndex])
                if not prompt or not pos then return "hilang" end

                local root = fRoot()
                if root and (root.Position - pos).Magnitude > 6 then
                    fMoveTo(pos + Vector3.new(0, 2, 0), 1.5)
                end

                for _ = 1, 3 do
                    fFirePrompt(prompt)
                    local t0 = os.clock()
                    while (os.clock() - t0) < 0.6 do
                        if isKeyLit(keyIndex) then
                            task.wait(0.08)
                            return areAllKeysLit() and "salah" or "ok"
                        end
                        task.wait(0.02)
                    end
                end

                return "hilang"
            end

            local failed = false
            for _, noteIndex in ipairs(recorded) do
                if KKG.farm ~= token or (Workspace:GetAttribute("SecretStage") ~= 2 and tonumber(Workspace:GetAttribute("SecretStage")) ~= 2) then
                    failed = true
                    break
                end

                local status = pressKeyUntilPlayed(noteIndex)
                if status ~= "ok" then
                    failed = true
                    break
                end

                task.wait(noteGap)
            end

            if not failed then
                waitUntil(function()
                    return (Workspace:GetAttribute("SecretStage") ~= 2 and tonumber(Workspace:GetAttribute("SecretStage")) ~= 2)
                end, 3)
            end

            waitUntil(areAllKeysStopped, 3)
        end
    end
end

local function fAutoSecretJob(jobKey)
    local function active()
        return KKG.farm == jobKey
    end

    local function getSecretRoot()
        return Workspace:FindFirstChild("SecretEnding")
    end

    local function stage()
        local s = getSecretRoot()
        local val = Workspace:GetAttribute("SecretStage")
        if val == nil and s then
            val = s:GetAttribute("SecretStage")
        end
        return tonumber(val) or 0
    end

    local function getOrderString()
        local s = getSecretRoot()
        local order = Workspace:GetAttribute("SecretOrderIds")
        if (not order or tostring(order) == "") and s then
            order = s:GetAttribute("SecretOrderIds")
        end
        return tostring(order or "")
    end

    local secret = getSecretRoot()
    if not secret then
        secret = Workspace:WaitForChild("SecretEnding", 8)
        if not secret or not active() then return end
    end

    local visitedPelita = {}
    local tStart = os.clock()

    while active() and (os.clock() - tStart) < 150 do
        secret = getSecretRoot()
        if not secret then break end

        local curStage = stage()

        if curStage < 1 then
            local photoClue = secret:FindFirstChild("PhotoClue")
            local spot = (photoClue and photoClue:FindFirstChild("Spot")) or photoClue
            if spot then
                fVisit(spot, 1.0, function()
                    return stage() >= 1
                end, jobKey)
            else
                task.wait(0.25)
            end

        elseif curStage == 1 then
            local byKey = {}
            local pelitaFolder = secret:FindFirstChild("Pelita")
            if pelitaFolder then
                for _, pelita in ipairs(pelitaFolder:GetChildren()) do
                    local sign = pelita:FindFirstChild("SymbolSign")
                    local nameLabel = sign and sign:FindFirstChild("SymbolName")
                    if nameLabel and nameLabel.Text then
                        local rawClean = cleanText(nameLabel.Text):lower()
                        local digits = rawClean:gsub("%D", "")
                        if rawClean ~= "" then
                            byKey[rawClean] = pelita
                        end
                        if digits ~= "" then
                            byKey[digits] = pelita
                        end
                    end
                end
            end

            local orderStr = getOrderString()
            local didAny = false
            for rawToken in string.gmatch(orderStr, "%S+") do
                if not active() or stage() ~= 1 then break end
                local tokenLower = cleanText(rawToken):lower()
                local tokenDigits = tokenLower:gsub("%D", "")
                local pelitaObj = byKey[tokenLower] or (tokenDigits ~= "" and byKey[tokenDigits]) or nil

                if pelitaObj and not visitedPelita[pelitaObj] then
                    didAny = true
                    visitedPelita[pelitaObj] = true
                    fVisit(pelitaObj, 0.7, nil, jobKey)
                end
            end

            if not didAny then
                task.wait(0.25)
            end

        elseif curStage == 2 then
            runAutoPlayMusic(jobKey)
            task.wait(0.5)

        elseif curStage == 3 then
            local pos = fPosOf(secret:FindFirstChild("RitualCircle"))
            if pos then
                fMoveTo(pos + Vector3.new(0, 2.5, 0), 1.6)
                task.wait(0.2)
            else
                task.wait(0.25)
            end

        else
            break
        end
    end
end

local AutoStartTriggered = false

local function fTriggerRun(mode)
    AutoStartTriggered = true
    KKG.moveId = KKG.moveId + 1
    KKG.farm = nil
    KKG.mode = nil

    local key = {}
    KKG.farm = key
    KKG.mode = mode
    syncAutoToggles(mode)

    task.spawn(function()
        local prevNoclip = State.Noclip
        State.Noclip = true

        local ok, err = pcall(function()
            if mode == "ending" then
                fAutoEndingJob(key)
            elseif mode == "secret" then
                fAutoSecretJob(key)
            end
        end)

        if not ok then
            warn("[AutoFarm Error]: " .. tostring(err))
        end

        State.Noclip = prevNoclip
        if KKG.farm == key then
            KKG.farm = nil
            KKG.mode = nil
            syncAutoToggles(nil)
        end
    end)
end

